tabs.misiones:Section({ Title = "QUESTS" })
tabs.misiones.AutoQuestActive = false
tabs.misiones:Toggle({
    Title = "Auto Collect Quests",
    Default = false,
    Callback = function(state)
        tabs.misiones.AutoQuestActive = state
        if state then
            task.spawn(function()
                local function processQuestsContainer(container)
                    for _, child in ipairs(container:GetChildren()) do
                        if child.Name ~= "completedQuests" then
                            if child:IsA("Folder") or child:IsA("Model") then
                                processQuestsContainer(child)
                            else
                                pcall(function()
                                    local questsEvent = services.ReplicatedStorage:WaitForChild("rEvents"):WaitForChild("questsEvent")
                                    local parentName = container.Name
                                    local grandParentName = container.Parent and container.Parent.Name or ""
                                    if parentName == "Enchant Quests" or grandParentName == "Enchant Quests" then
                                        questsEvent:FireServer("collectEnchantQuest", child)
                                        questsEvent:FireServer("collectEnchantQuest", child.Name)
                                    elseif parentName == "Daily Quests" or grandParentName == "Daily Quests" then
                                        questsEvent:FireServer("collectDailyQuest", child)
                                        questsEvent:FireServer("collectDailyQuest", child.Name)
                                        questsEvent:FireServer("collectQuest", child)
                                        questsEvent:FireServer("collectQuest", child.Name)
                                    else
                                        questsEvent:FireServer("collectQuest", child)
                                        questsEvent:FireServer("collectQuest", child.Name)
                                    end
                                end)
                            end
                        end
                    end
                end
                while tabs.misiones.AutoQuestActive and utils.isCurrent() do
                    pcall(function()
                        local questsFolder = lp.player:FindFirstChild("Quests")
                        if questsFolder then
                            processQuestsContainer(questsFolder)
                        else
                            for _, folder in pairs(lp.player:GetChildren()) do
                                if folder:IsA("Folder") and string.find(string.lower(folder.Name), "quest") then
                                    processQuestsContainer(folder)
                                end
                            end
                        end
                        if getnilinstances then
                            for _, obj in ipairs(getnilinstances()) do
                                pcall(function()
                                    local parent = obj.Parent
                                    local parentName = parent and parent.Name or ""
                                    if parentName == "Daily Quests" or parentName == "Enchant Quests" or parentName == "Quests" or obj.Name == "Mighty Fists" or obj.Name == "Rep Sensei" or obj.Name == "Rebirth Wizard" then
                                        local questsEvent = services.ReplicatedStorage:WaitForChild("rEvents"):WaitForChild("questsEvent")
                                        questsEvent:FireServer("collectQuest", obj)
                                        questsEvent:FireServer("collectDailyQuest", obj)
                                        questsEvent:FireServer("collectEnchantQuest", obj)
                                    end
                                end)
                            end
                        end
                    end)
                    task.wait(1.5)
                end
            end)
        end
    end
})

