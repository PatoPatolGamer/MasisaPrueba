task.spawn(function()
    while utils.isCurrent() do
        task.wait(0.05)
        if killConfig.autoKill then
            local targetToKill = nil
            if killConfig.targetMode and killConfig.targetPlayer then
                local target = services.Players:FindFirstChild(killConfig.targetPlayer)
                if target and target.Character then targetToKill = target.Character end
            else
                local localChar = lp.player.Character
                local shortestDistance = math.huge
                if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                    for _, player in ipairs(services.Players:GetPlayers()) do
                        if player ~= lp.player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (localChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                            if distance < shortestDistance then
                                shortestDistance = distance
                                targetToKill = player.Character
                            end
                        end
                    end
                end
            end
            local localCharacter = lp.player.Character
            if targetToKill and targetToKill:FindFirstChild("HumanoidRootPart") and localCharacter and localCharacter:FindFirstChild("HumanoidRootPart") then
                local targetPosition = targetToKill.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                localCharacter:PivotTo(targetPosition)
                localCharacter.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                if utils.remotes.MuscleEvent then
                    utils.remotes.MuscleEvent:FireServer("punch", "rightHand")
                    utils.remotes.MuscleEvent:FireServer("punch", "leftHand")
                end
            end
        end
    end
end)

