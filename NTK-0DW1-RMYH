        tabs.fullFarm.elapsed = tabs.fullFarm.elapsed + tick() - tabs.fullFarm.startedAt
    end
    tabs.fullFarm.Runtime:SetDesc(string.format("%dd %dh %dm %ds",
        math.floor(tabs.fullFarm.elapsed / 86400), math.floor((tabs.fullFarm.elapsed % 86400) / 3600),
