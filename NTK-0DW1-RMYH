tabs.fullRebirth.equipPetsByNameV2 = function(petNames, maxPets)
    maxPets = maxPets or 12
    local uniquePets = lp.player.petsFolder.Unique
    local equipped = 0
    
    for _, folder in pairs(lp.player.petsFolder:GetChildren()) do
        if folder:IsA("Folder") and folder.Name ~= "Unique" then
            for _, pet in pairs(folder:GetChildren()) do
                pcall(function() services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet) end)
            end
        end
    end
    task.wait(0.1)
    
    for _, petName in ipairs(petNames) do
        if equipped >= maxPets then break end
        for _, pet in pairs(uniquePets:GetChildren()) do
            if equipped >= maxPets then break end
            if pet.Name == petName then
                pcall(function() services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet) end)
                equipped = equipped + 1
                task.wait(0.05)
            end
        end
    end
    return equipped
end

tabs.fullRebirth.FastRebirthV2Worker = function()
    tabs.fullRebirth.FastRebirthV2Data.StartRebirths = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
    tabs.fullRebirth.updateRebirthStats()
    tabs.fullRebirth.FastRebirthV2Data.TotalRebirths = 0
    local lastCheck = tick()
    local lastRebirthCount = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
    local startTime = tick()
    
    while utils.isCurrent() and tabs.fullRebirth.FastRebirthV2Data.Running do
        if tabs.fullRebirth.FastRebirthV2Data.TargetRebirths > 0 and tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value >= tabs.fullRebirth.FastRebirthV2Data.TargetRebirths then
            tabs.fullRebirth.FastRebirthV2Status:SetDesc("Target reached!")
            tabs.fullRebirth.FastRebirthV2Data.Running = false
            break
        end
        
        if tabs.fullRebirth.FastRebirthV2Data.UseFarmPets then
            tabs.fullRebirth.FastRebirthV2Status:SetDesc("Equipping speed pets...")
            pcall(function() tabs.fullRebirth.equipPetsByNameV2(tabs.fullRebirth.FastRebirthV2Data.RepPets, 12) end)
            task.wait(0.3)
        end
        
        local currentRebirths = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
        local targetStrength = 5000 + currentRebirths * 2550
        local repsPerBurst = lp.player.MembershipType == Enum.MembershipType.Premium and 6 or 12
        
        tabs.fullRebirth.FastRebirthV2Status:SetDesc("Farming... " .. utils.formatNumber(tabs.fullRebirth.FastRebirthV2Data.Strength.Value) .. " / " .. utils.formatNumber(targetStrength))
        
        while utils.isCurrent() and tabs.fullRebirth.FastRebirthV2Data.Running and tabs.fullRebirth.FastRebirthV2Data.Strength.Value < targetStrength do
            for i = 1, repsPerBurst do
                pcall(function() utils.remotes.MuscleEvent:FireServer("rep") end)
            end
            task.wait(0.02)
        end
        
        if utils.isCurrent() and tabs.fullRebirth.FastRebirthV2Data.Running and tabs.fullRebirth.FastRebirthV2Data.Strength.Value >= targetStrength then
            if tabs.fullRebirth.FastRebirthV2Data.UsePackPets then
                tabs.fullRebirth.FastRebirthV2Status:SetDesc("Equipping pack pets...")
                pcall(function() tabs.fullRebirth.equipPetsByNameV2(tabs.fullRebirth.FastRebirthV2Data.PackPets, 12) end)
                task.wait(0.5)
            end
            
            tabs.fullRebirth.FastRebirthV2Status:SetDesc("Rebirthing...")
            local rebirthValueBefore = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
            local attempts = 0
            
            repeat
                pcall(function() services.ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest") end)
                task.wait(0.05)
                attempts = attempts + 1
            until not tabs.fullRebirth.FastRebirthV2Data.Running or tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value > rebirthValueBefore or attempts >= 50
            
            if tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value > rebirthValueBefore then
                tabs.fullRebirth.FastRebirthV2Data.TotalRebirths = tabs.fullRebirth.FastRebirthV2Data.TotalRebirths + (tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value - rebirthValueBefore)
                tabs.fullRebirth.FastRebirthV2Data.LastRebirthTime = tick()
            end
            
            if tabs.fullRebirth.FastRebirthV2Data.UseGolems then
                tabs.fullRebirth.FastRebirthV2Status:SetDesc("Re-equipping golems...")
                task.wait(0.5)
                pcall(function() tabs.fullRebirth.equipPetsByNameV2(tabs.fullRebirth.FastRebirthV2Data.GolemPets, 12) end)
            end
        end
        
        if tick() - lastCheck >= 1 then
            local currentCount = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
            local gained = currentCount - lastRebirthCount
            tabs.fullRebirth.FastRebirthV2Speed:SetDesc(gained .. " rebirths/s")
            lastRebirthCount = currentCount
            
            local secElapsed = tick() - startTime
            local totalGained = currentCount - tabs.fullRebirth.FastRebirthV2Data.StartRebirths
            if totalGained > 0 then
                local avgSecPerRb = secElapsed / totalGained
                tabs.fullRebirth.AvgTimeLabel:SetDesc(string.format("%.2f s/rebirth", avgSecPerRb))
                
                if tabs.fullRebirth.TargetRebirths > 0 then
                    local missing = math.max(0, tabs.fullRebirth.TargetRebirths - currentCount)
                    tabs.fullRebirth.MissingLabel:SetDesc(utils.formatWithCommas(missing))
                    local etaSec = missing * avgSecPerRb
                    local etaD = math.floor(etaSec / 86400)
                    local etaH = math.floor((etaSec % 86400) / 3600)
                    local etaM = math.floor((etaSec % 3600) / 60)
                    local etaS = math.floor(etaSec % 60)
                    tabs.fullRebirth.EtaLabel:SetDesc(string.format("%dd %dh %dm %ds", etaD, etaH, etaM, etaS))
                end
            end
            lastCheck = tick()
        end
        task.wait(0.3)
    end
    tabs.fullRebirth.FastRebirthV2Data.WorkerActive = false
end

